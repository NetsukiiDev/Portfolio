// MariaDB / MySQL variant of prisma/schema.prisma.
// To switch: `npm run db:use:mysql`, set DATABASE_URL to a mysql:// connection
// string in .env.local, then `npm run db:migrate`. See README for details.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-mysql"
}

datasource db {
  provider = "mysql"
}

model Project {
  id         String   @id
  slug       String   @unique
  featured   Boolean  @default(false)
  order      Int      @default(0)
  category   String
  images     Json
  links      Json
  techStack  Json
  translations Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BlogPost {
  id          String    @id
  slug        String    @unique
  status      String
  coverImage  String
  tags        Json
  readingTime Int
  translations Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model SkillCategory {
  id           String  @id
  order        Int     @default(0)
  translations Json
  skills       Skill[]
}

model Skill {
  id               String        @id
  categoryId       String
  category         SkillCategory @relation(fields: [categoryId], references: [id])
  icon             String
  proficiency      Int
  yearsOfExperience Int
  order            Int           @default(0)
  translations     Json

  @@index([categoryId])
}

model Experience {
  id           String    @id
  type         String
  startDate    String
  endDate      String?
  current      Boolean   @default(false)
  order        Int       @default(0)
  company      String
  logo         String
  website      String?
  translations Json
}

model AiImage {
  id             String   @id
  image          String
  thumbnail      String
  tags           Json
  model          String
  sampler        String
  steps          Int
  cfgScale       Float
  seed           Int
  negativePrompt String   @db.Text
  loras          Json
  translations   Json
  createdAt      DateTime @default(now())
}

model Settings {
  id               String    @id @default("singleton")
  personal         Json
  social           Json
  seo              Json
  contactForm      Json
  maintenance      Json
  defaultLocale    String    @default("en")
  themePalette     String    @default("violet")
  themeMode        String    @default("dark")
  domain           String    @default("")
  https            Boolean   @default(true)
  storage          Json?
  modules          Json?
  home             Json?
  language         Json?
  pages            Json?
  tunnel           Json?
  sections         Json?
  tools            Json?
  setupCompletedAt DateTime?
}

model Tool {
  id    String  @id
  slug  String?
  name  String?
  image String?
  url   String?
  order Int     @default(0)
}

model ContactMessage {
  id        String   @id
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model AdminAccount {
  id           String   @id @default("singleton")
  firstName    String   @default("")
  lastName     String   @default("")
  username     String   @unique
  passwordHash String
  updatedAt    DateTime @updatedAt
}
